# The web app, where the site's buttons send visitors to sign up or sign in.
# Read at build time, rebuild after changing it.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# The site's own address, for canonical links, the sitemap and robots.txt.
# Only https://readyyet.app is open to search engines.
SITE_URL=http://localhost:3002

# PostHog's project key, public by design. Unset, no cookie banner shows and
# nothing is measured (ADR 0132). Read at build time.
NEXT_PUBLIC_POSTHOG_KEY=
