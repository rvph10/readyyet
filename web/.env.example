# The API, called from the web app's server only. On Railway, its private
# network address.
API_URL=http://localhost:3000
# The API's public address, for signing in from the browser. Read at build
# time, rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:3000
# The bucket's address, the same as the API's. Ticket photos load from it, so
# the Content-Security-Policy has to allow it.
S3_ENDPOINT=http://localhost:9090
# The sales site, linked from the sign-in page.
SITE_URL=http://localhost:3002
# A monitored inbox, shown on the sign-in page for anyone stuck.
SUPPORT_EMAIL=support@readyyet.app
# The Be Bold icon pack's SVG folder on your machine, for pnpm icon (ADR 0055).
BE_BOLD_SVG_DIR=
