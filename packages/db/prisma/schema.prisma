generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Managed by Better Auth's Prisma adapter, shown here for relation completeness only.
model User {
  id            String    @id
  email         String    @unique
  name          String
  // The avatar's key in the bucket, never a URL (ADR 0026). Better Auth's
  // own name for the column.
  image         String?
  emailVerified Boolean   @default(false) @map("email_verified")
  // Language of the emails this User receives (ADR 0018). Declared to
  // Better Auth as an additionalField in api/src/auth/auth.ts.
  locale        Locale    @default(EN)
  // Set when the User deleted their account: name and email are replaced,
  // the row stays for the history that points at it (ADR 0018).
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions Session[]
  accounts Account[]

  ownedBusinesses Business[]          @relation("BusinessOwner")
  memberships     Membership[]
  invitationsSent Invitation[]        @relation("InvitedBy")
  ticketsCreated  Ticket[]            @relation("TicketCreatedBy")
  statusEvents    TicketStatusEvent[]
  photosUploaded  TicketPhoto[]       @relation("TicketPhotoUploadedBy")

  @@map("user")
}

// Session, Account, and Verification below are Better Auth's own tables,
// their shape is dictated by `better-auth generate` (see api/src/auth/auth.ts),
// not hand-designed. Re-run that CLI and diff before hand-editing these.

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum InvitationRole {
  ADMIN
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Locale {
  EN
  FR
}

enum Plan {
  ESSENTIEL
  PRO
}

enum BillingInterval {
  MONTH
  YEAR
}

// TRIAL is ours alone, Stripe has no subscription yet. The other three
// mirror the Stripe subscription (ADR 0033).
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  ENDED
}

model Business {
  id               String   @id @default(uuid()) @db.Uuid
  ownerId          String   @map("owner_id")
  name             String
  stripeCustomerId String?  @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner     User       @relation("BusinessOwner", fields: [ownerId], references: [id])
  locations Location[]

  @@map("business")
}

model BusinessType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  translations BusinessTypeTranslation[]
  locations    Location[]
  workflows    Workflow[]

  @@map("business_type")
}

model BusinessTypeTranslation {
  businessTypeId Int    @map("business_type_id")
  locale         Locale
  label          String

  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@id([businessTypeId, locale])
  @@map("business_type_translation")
}

model Location {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @map("business_id") @db.Uuid
  businessTypeId  Int       @map("business_type_id")
  name            String
  contactPhone    String    @map("contact_phone")
  contactEmail    String    @map("contact_email")
  // The logo's key in the bucket, never a URL (ADR 0026).
  logoKey         String?   @map("logo_key")
  // Default language for this Location's customer emails and tracking
  // page, a Customer's own locale overrides it. See ADR 0015.
  locale          Locale
  // ADR 0034: schema.org's PostalAddress fields, all four or none.
  streetAddress   String?   @map("street_address")
  postalCode      String?   @map("postal_code")
  addressLocality String?   @map("address_locality")
  // ISO 3166-1 alpha-2.
  addressCountry  String?   @map("address_country")
  // A region's IANA name, never an offset, opening hours are wall-clock
  // times in it.
  timeZone        String    @map("time_zone")
  // schema.org OpeningHoursSpecification entries, see ADR 0034.
  openingHours    Json      @default("[]") @map("opening_hours")
  // Open days to a new Ticket's estimated ready date, null leaves it
  // empty. 1 to 60, a CHECK enforces it (ADR 0036).
  turnaroundDays  Int?      @map("turnaround_days")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessType BusinessType  @relation(fields: [businessTypeId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  invitations  Invitation[]
  customers    Customer[]
  tickets      Ticket[]
  workflows    Workflow[]
  subscription Subscription?

  @@index([businessId])
  @@map("location")
}

model Membership {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id")
  locationId String   @map("location_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  locationId String           @map("location_id") @db.Uuid
  email      String
  role       InvitationRole
  invitedBy  String           @map("invited_by")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inviter  User     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)
  // Partial unique index (location_id, lower(email)) WHERE status = 'PENDING'
  // added via raw SQL migrations, see docs/architecture/data-model.md.

  @@map("invitation")
}

model Customer {
  id                BigInt    @id @default(autoincrement())
  locationId        String    @map("location_id") @db.Uuid
  fullName          String    @map("full_name")
  email             String?
  phone             String?
  locale            Locale?
  // Set from Resend's webhook when mail to this address bounces for good
  // or is reported as spam, no more customer emails go to it until staff
  // change the address, which clears both.
  emailBouncedAt    DateTime? @map("email_bounced_at")
  emailComplainedAt DateTime? @map("email_complained_at")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tickets  Ticket[]

  @@unique([id, locationId])
  @@index([locationId, fullName])
  @@map("customer")
}

model Status {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  translations  StatusTranslation[]
  workflowSteps WorkflowStep[]
  tickets       Ticket[]
  statusEvents  TicketStatusEvent[]

  @@map("status")
}

model StatusTranslation {
  statusId Int    @map("status_id")
  locale   Locale
  label    String

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([statusId, locale])
  @@map("status_translation")
}

model Workflow {
  id             BigInt   @id @default(autoincrement())
  businessTypeId Int?     @map("business_type_id")
  locationId     String?  @map("location_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  businessType BusinessType?  @relation(fields: [businessTypeId], references: [id], onDelete: Restrict)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  tickets      Ticket[]
  // CHECK (business_type_id IS NOT NULL) <> (location_id IS NOT NULL)
  // + partial unique "one active per business_type_id" / "one active per location_id"
  // added via raw SQL migrations, see docs/architecture/data-model.md.

  @@map("workflow")
}

model WorkflowStep {
  workflowId BigInt @map("workflow_id")
  position   Int
  statusId   Int    @map("status_id")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Restrict)

  tickets      Ticket[]
  statusEvents TicketStatusEvent[]

  @@id([workflowId, position])
  @@unique([workflowId, statusId])
  @@map("workflow_step")
}

model Ticket {
  id                     BigInt    @id @default(autoincrement())
  locationId             String    @map("location_id") @db.Uuid
  customerId             BigInt    @map("customer_id")
  workflowId             BigInt    @map("workflow_id")
  currentStatusId        Int       @map("current_status_id")
  trackingCode           String    @unique @map("tracking_code")
  title                  String
  description            String?
  createdBy              String    @map("created_by")
  // Set when the Customer used the "stop updates" link, no more status
  // update emails for this ticket from then on (ADR 0015).
  notificationsStoppedAt DateTime? @map("notifications_stopped_at")
  // A date on the Location's clock, no time (ADR 0030).
  estimatedReadyDate     DateTime? @map("estimated_ready_date") @db.Date
  // The last date an email told the Customer: moving the date past it
  // queues an email due at readyDateEmailDueAt, it's only sent if the date
  // is still later then.
  customerToldReadyDate  DateTime? @map("customer_told_ready_date") @db.Date
  readyDateEmailDueAt    DateTime? @map("ready_date_email_due_at")
  // Uncollected item reminders (ADR 0028, ADR 0037): reaching READY
  // resets the count and schedules the first one.
  customerCollectedAt    DateTime? @map("customer_collected_at")
  readyRemindersSent     Int       @default(0) @map("ready_reminders_sent")
  nextReadyReminderAt    DateTime? @map("next_ready_reminder_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  location      Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  workflow      Workflow            @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  currentStatus Status              @relation(fields: [currentStatusId], references: [id], onDelete: Restrict)
  creator       User                @relation("TicketCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  statusEvents  TicketStatusEvent[]
  photos        TicketPhoto[]

  // Composite FKs enforce the tenant boundary and the workflow/status
  // relationship at the database level, not just in application code.
  // See docs/architecture/data-model.md#tenant-scoped-foreign-keys.
  customer     Customer     @relation(fields: [customerId, locationId], references: [id, locationId], onDelete: Restrict)
  workflowStep WorkflowStep @relation(fields: [workflowId, currentStatusId], references: [workflowId, statusId], onDelete: Restrict)

  @@unique([id, workflowId])
  @@index([locationId, createdAt(sort: Desc)])
  @@index([locationId, currentStatusId, createdAt(sort: Desc)])
  @@index([customerId])
  @@index([readyDateEmailDueAt])
  @@index([currentStatusId, nextReadyReminderAt])
  @@map("ticket")
}

// At most 5 per Ticket, deleted when its tracking link expires (ADR 0026).
model TicketPhoto {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @map("ticket_id")
  // The object's key in the bucket, never a URL.
  objectKey  String   @unique @map("object_key")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  uploader User   @relation("TicketPhotoUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_photo")
}

model TicketStatusEvent {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @map("ticket_id")
  workflowId BigInt   @map("workflow_id")
  statusId   Int      @map("status_id")
  changedBy  String   @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  status  Status @relation(fields: [statusId], references: [id], onDelete: Restrict)
  changer User   @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  // workflowId is a copy of the parent ticket's workflowId (always equal,
  // workflows are frozen per ticket). Both composite FKs below are needed
  // together: this one pins workflowId to the actual parent ticket's
  // workflowId (not just any ticket), the other pins statusId to a real
  // step of that workflow. Neither alone stops workflowId from silently
  // drifting to a different (but validly-shaped) workflow.
  // See docs/architecture/data-model.md#tenant-scoped-foreign-keys.
  ticket       Ticket       @relation(fields: [ticketId, workflowId], references: [id, workflowId], onDelete: Cascade)
  workflowStep WorkflowStep @relation(fields: [workflowId, statusId], references: [workflowId, statusId], onDelete: Restrict)

  pendingNotification PendingStatusNotification?

  @@index([ticketId, createdAt])
  @@map("ticket_status_event")
}

// Not a per-event log, one row per send-attempt sequence. type stays a
// plain string (not a Prisma enum) since the set of email types is still
// being decided, a new one shouldn't need a migration.
model EmailLog {
  id            String      @id @default(uuid()) @db.Uuid
  resendId      String?     @unique @map("resend_id")
  to            String
  // Kept so a retry sends from the same name, with the same Reply-To.
  fromName      String?     @map("from_name")
  replyTo       String?     @map("reply_to")
  // Extra headers (List-Unsubscribe), a flat name to value object.
  headers       Json?
  subject       String
  // react content is rendered to html at send time and stored here, so a
  // later retry (a fresh process, possibly minutes later) has the exact
  // content to resend without needing the original React element again.
  html          String?
  text          String?
  type          String
  status        EmailStatus @default(QUEUED)
  attempts      Int         @default(0)
  lastError     String?     @map("last_error")
  lastEvent     Json?       @map("last_event")
  lastAttemptAt DateTime?   @map("last_attempt_at")
  deliveredAt   DateTime?   @map("delivered_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([status, lastAttemptAt])
  @@map("email_log")
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  BOUNCED
  COMPLAINED
  DELAYED
  FAILED
}

// A Location's billing state (ADR 0031, ADR 0033). During a trial `plan`
// is PRO, a Location that never had a trial nor paid has none.
model Subscription {
  locationId           String             @id @map("location_id") @db.Uuid
  status               SubscriptionStatus
  plan                 Plan?
  interval             BillingInterval?
  trialEndsAt          DateTime?          @map("trial_ends_at")
  trialReminderSentAt  DateTime?          @map("trial_reminder_sent_at")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  // A move to a cheaper price waiting for the period to end.
  scheduledPlan        Plan?              @map("scheduled_plan")
  scheduledInterval    BillingInterval?   @map("scheduled_interval")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("subscription")
}

// A customer status email waiting out the undo window (ADR 0015, ADR
// 0016). Deleted with its status event, so an undone change never sends.
model PendingStatusNotification {
  statusEventId BigInt   @id @map("status_event_id")
  sendAfter     DateTime @map("send_after")

  statusEvent TicketStatusEvent @relation(fields: [statusEventId], references: [id], onDelete: Cascade)

  @@index([sendAfter])
  @@map("pending_status_notification")
}
