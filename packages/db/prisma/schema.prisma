generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// Managed by Better Auth's Prisma adapter, shown here for relation completeness only.
model User {
  id            String   @id
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  ownedBusinesses Business[]          @relation("BusinessOwner")
  memberships     Membership[]
  invitationsSent Invitation[]        @relation("InvitedBy")
  ticketsCreated  Ticket[]            @relation("TicketCreatedBy")
  statusEvents    TicketStatusEvent[]

  @@map("user")
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum InvitationRole {
  ADMIN
  EMPLOYEE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Locale {
  EN
  FR
}

enum Plan {
  TRIAL
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model Business {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner     User       @relation("BusinessOwner", fields: [ownerId], references: [id])
  locations Location[]

  @@map("business")
}

model BusinessType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  translations BusinessTypeTranslation[]
  locations    Location[]
  workflows    Workflow[]

  @@map("business_type")
}

model BusinessTypeTranslation {
  businessTypeId Int    @map("business_type_id")
  locale         Locale
  label          String

  businessType BusinessType @relation(fields: [businessTypeId], references: [id], onDelete: Cascade)

  @@id([businessTypeId, locale])
  @@map("business_type_translation")
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  businessTypeId Int       @map("business_type_id")
  name           String
  contactPhone   String    @map("contact_phone")
  contactEmail   String    @map("contact_email")
  logoUrl        String?   @map("logo_url")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  businessType BusinessType  @relation(fields: [businessTypeId], references: [id], onDelete: Restrict)
  memberships  Membership[]
  invitations  Invitation[]
  customers    Customer[]
  tickets      Ticket[]
  workflows    Workflow[]
  subscription Subscription?

  @@index([businessId])
  @@map("location")
}

model Membership {
  id         BigInt   @id @default(autoincrement())
  userId     String   @map("user_id")
  locationId String   @map("location_id") @db.Uuid
  role       Role
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@index([userId])
  @@map("membership")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  locationId String           @map("location_id") @db.Uuid
  email      String
  role       InvitationRole
  invitedBy  String           @map("invited_by")
  status     InvitationStatus @default(PENDING)
  expiresAt  DateTime         @map("expires_at")
  acceptedAt DateTime?        @map("accepted_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  inviter  User     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Restrict)
  // Partial unique index (location_id, lower(email)) WHERE status = 'PENDING'
  // added via raw SQL migrations, see docs/architecture/data-model.md.

  @@map("invitation")
}

model Customer {
  id         BigInt    @id @default(autoincrement())
  locationId String    @map("location_id") @db.Uuid
  fullName   String    @map("full_name")
  email      String?
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  tickets  Ticket[]

  @@unique([id, locationId])
  @@index([locationId, fullName])
  @@map("customer")
}

model Status {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  translations  StatusTranslation[]
  workflowSteps WorkflowStep[]
  tickets       Ticket[]
  statusEvents  TicketStatusEvent[]

  @@map("status")
}

model StatusTranslation {
  statusId Int    @map("status_id")
  locale   Locale
  label    String

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@id([statusId, locale])
  @@map("status_translation")
}

model Workflow {
  id             BigInt   @id @default(autoincrement())
  businessTypeId Int?     @map("business_type_id")
  locationId     String?  @map("location_id") @db.Uuid
  name           String
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  businessType BusinessType?  @relation(fields: [businessTypeId], references: [id], onDelete: Restrict)
  location     Location?      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  steps        WorkflowStep[]
  tickets      Ticket[]
  // CHECK (business_type_id IS NOT NULL) <> (location_id IS NOT NULL)
  // + partial unique "one active per business_type_id" / "one active per location_id"
  // added via raw SQL migrations, see docs/architecture/data-model.md.

  @@map("workflow")
}

model WorkflowStep {
  workflowId BigInt @map("workflow_id")
  position   Int
  statusId   Int    @map("status_id")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status   Status   @relation(fields: [statusId], references: [id], onDelete: Restrict)

  tickets      Ticket[]
  statusEvents TicketStatusEvent[]

  @@id([workflowId, position])
  @@unique([workflowId, statusId])
  @@map("workflow_step")
}

model Ticket {
  id              BigInt   @id @default(autoincrement())
  locationId      String   @map("location_id") @db.Uuid
  customerId      BigInt   @map("customer_id")
  workflowId      BigInt   @map("workflow_id")
  currentStatusId Int      @map("current_status_id")
  trackingCode    String   @unique @map("tracking_code")
  title           String
  description     String?
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  location      Location            @relation(fields: [locationId], references: [id], onDelete: Restrict)
  workflow      Workflow            @relation(fields: [workflowId], references: [id], onDelete: Restrict)
  currentStatus Status              @relation(fields: [currentStatusId], references: [id], onDelete: Restrict)
  creator       User                @relation("TicketCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  statusEvents  TicketStatusEvent[]

  // Composite FKs enforce the tenant boundary and the workflow/status
  // relationship at the database level, not just in application code.
  // See docs/architecture/data-model.md#tenant-scoped-foreign-keys.
  customer     Customer     @relation(fields: [customerId, locationId], references: [id, locationId], onDelete: Restrict)
  workflowStep WorkflowStep @relation(fields: [workflowId, currentStatusId], references: [workflowId, statusId], onDelete: Restrict)

  @@index([locationId, createdAt(sort: Desc)])
  @@index([locationId, currentStatusId, createdAt(sort: Desc)])
  @@index([customerId])
  @@map("ticket")
}

model TicketStatusEvent {
  id         BigInt   @id @default(autoincrement())
  ticketId   BigInt   @map("ticket_id")
  workflowId BigInt   @map("workflow_id")
  statusId   Int      @map("status_id")
  changedBy  String   @map("changed_by")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  status  Status @relation(fields: [statusId], references: [id], onDelete: Restrict)
  changer User   @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  // workflowId is a copy of the parent ticket's workflowId (always equal,
  // workflows are frozen per ticket), carried here only so this composite
  // FK can enforce "this status belongs to the ticket's workflow" at the
  // database level. See docs/architecture/data-model.md#tenant-scoped-foreign-keys.
  workflowStep WorkflowStep @relation(fields: [workflowId, statusId], references: [workflowId, statusId], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_status_event")
}

model Subscription {
  locationId           String             @id @map("location_id") @db.Uuid
  stripeCustomerId     String             @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  plan                 Plan               @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?          @map("current_period_end")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("subscription")
}
