DATABASE_URL="postgresql://readyyet:readyyet@localhost:5432/readyyet"
PORT=3000
# "development" (default) or "production". Gates pino-pretty log
# formatting and whether /docs (Swagger) is served at all.
NODE_ENV=development
# Optional, defaults to "info" if unset.
LOG_LEVEL=info
# Generate with: pnpm exec better-auth secret
BETTER_AUTH_SECRET=
# The API's own public URL, also the base of the one-click stop link
# in customer emails (List-Unsubscribe).
BETTER_AUTH_URL=http://localhost:3000
# From resend.com/api-keys
RESEND_API_KEY=
# From the webhook's page in the Resend dashboard, after registering a
# webhook endpoint pointing at <public URL>/webhooks/resend
RESEND_WEBHOOK_SECRET=
# A sender address on a domain verified in Resend, e.g. "ReadyYet <hello@readyyet.app>"
EMAIL_FROM=
# A monitored inbox, the Reply-To of emails that tell a User to get in
# touch if something wasn't them (an ownership transfer, a deleted account).
SUPPORT_EMAIL=
# The web app's origin: the only origin allowed by CORS and Better Auth's
# trustedOrigins, and the base for links in emails.
WEB_URL=http://localhost:3001
# Error tracking, the project's DSN from sentry.io. Leave empty locally,
# required in production.
SENTRY_DSN=
