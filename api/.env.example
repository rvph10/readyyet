DATABASE_URL="postgresql://readyyet:readyyet@localhost:5432/readyyet"
PORT=3000
# "development" (default) or "production". Gates pino-pretty log
# formatting and whether /docs (Swagger) is served at all.
NODE_ENV=development
# Optional, defaults to "info" if unset.
LOG_LEVEL=info
# Generate with: pnpm exec better-auth secret
BETTER_AUTH_SECRET=
# The API's own public URL, also the base of the one-click stop link
# in customer emails (List-Unsubscribe).
BETTER_AUTH_URL=http://localhost:3000
# From resend.com/api-keys
RESEND_API_KEY=
# From the webhook's page in the Resend dashboard, after registering a
# webhook endpoint pointing at <public URL>/webhooks/resend
RESEND_WEBHOOK_SECRET=
# A sender address on a domain verified in Resend, e.g. "ReadyYet <hello@readyyet.app>"
EMAIL_FROM=
# A monitored inbox, the Reply-To of emails that tell a User to get in
# touch if something wasn't them (an ownership transfer, a deleted account).
SUPPORT_EMAIL=
# The web app's origin: the only origin allowed by CORS and Better Auth's
# trustedOrigins, and the base for links in emails.
WEB_URL=http://localhost:3001
# Error tracking, the project's DSN from sentry.io. Required in production.
# Optional locally: errors then show under the "development" environment,
# cron check-ins are only sent in production.
SENTRY_DSN=
# A test mode secret key (sk_test_), never a live key outside production
# (Developers > API keys, with the test mode toggle on).
STRIPE_SECRET_KEY=
# The signing secret of the Stripe webhook endpoint pointing at
# <public URL>/webhooks/stripe. Required in production. Locally, the one
# `stripe listen --forward-to localhost:3000/webhooks/stripe` prints.
STRIPE_WEBHOOK_SECRET=
# Comma-separated emails of the accounts that reach the back office
# (sales partners and their commissions, ADR 0032). None when empty.
PLATFORM_ADMIN_EMAILS=
# The bucket holding photos, logos and avatars (ADR 0026). Locally, the
# S3Mock container from docker-compose.yml, which accepts any key. On
# Railway, the Bucket's own credentials.
S3_ENDPOINT=http://localhost:9090
S3_REGION=us-east-1
S3_BUCKET=readyyet
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
