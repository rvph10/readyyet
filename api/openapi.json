  "info": {
    "title": "ReadyYet API",
    "description": "Better Auth's own routes (/api/auth/*) aren't included here, they're raw middleware, not Nest controllers. See ADR 0008/0011.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      }
    },
    "schemas": {
      "CreateLocationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "businessTypeCode": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "locale": {
            "enum": [
              "EN",
              "FR"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "businessTypeCode",
          "contactPhone",
          "contactEmail",
          "locale"
        ]
      },
      "CreateBusinessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "location": {
            "$ref": "#/components/schemas/CreateLocationDto"
          }
        },
        "required": [
          "name",
          "location"
        ]
      },
      "UpdateBusinessDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "TransferOwnershipDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          }
        },
        "required": [
          "userId"
        ]
      },
      "UpdateLocationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string",
            "format": "email"
          },
          "logoUrl": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "EN",
              "FR"
            ]
          }
        }
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": [
              "EN",
              "FR"
            ]
          }
        },
        "required": [
          "locale"
        ]
      },
      "CreateCustomerDto": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "phone": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "EN",
              "FR"
            ]
          }
        },
        "required": [
          "fullName"
        ]
      },
      "CreateTicketDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "customer": {
            "$ref": "#/components/schemas/CreateCustomerDto"
          }
        },
        "required": [
          "title"
        ]
